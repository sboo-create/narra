narra-video.multitool.works {
	header {
		Content-Type application/json
		Cache-Control "no-store"
		X-Content-Type-Options nosniff
	}

	respond /health `{"ok":false,"status":"waiting_for_secure_origin","service":"narra-video"}` 503
	respond `{"error":"Narra video relay is waiting for HTTPS or a private origin tunnel"}` 503
}
