{
  "name": "narra",
  "version": "0.6.5",
  "description": "Narra — AI-читалка живых книг (десктоп-прототип)",
  "author": "Narra",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "proxy": "node --env-file=server/.env server/index.mjs",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --mac",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "fetch-content": "node scripts/fetch-content.mjs"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "pdf-parse": "^1.1.1",
    "uuid": "^9.0.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.2.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.3"
  },
  "build": {
    "appId": "com.narra.app",
    "productName": "Narra",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "content/**/*"
    ],
    "extraResources": [
      {
        "from": "content",
        "to": "content"
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.book"
    },
    "artifactName": "${productName}-arm64.${ext}"
  }
}