{
  "name": "narra",
  "version": "0.7.7",
  "description": "Narra — AI-читалка живых книг (десктоп-прототип)",
  "author": "Narra",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "proxy": "node --env-file=server/.env server/index.mjs",
    "build": "electron-vite build",
    "dist": "node scripts/verify-release-env.mjs && electron-vite build && electron-builder --mac",
    "dist:unsigned": "NARRA_UPDATE_BASE_URL=https://updates.invalid electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false NARRA_UPDATE_BASE_URL=https://updates.invalid electron-builder --mac -c.mac.identity=null -c.mac.hardenedRuntime=false -c.mac.notarize=false && node scripts/finalize-update-feed.mjs",
    "release:verify": "bash scripts/verify-macos-release.sh",
    "release:verify:unsigned": "bash scripts/verify-unsigned-macos.sh",
    "test:gateway": "node --test server/test/*.test.mjs",
    "test:release": "node --test scripts/*.test.mjs",
    "test:stats": "cd stats && .venv/bin/python -m unittest -v test_server.py",
    "security:audit": "npm audit --audit-level=moderate",
    "smoke:pdf-worker": "electron scripts/smoke-pdf-worker.cjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "fetch-content": "node scripts/fetch-content.mjs",
    "push": "bash scripts/push.sh"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "pdf-parse": "^2.4.5",
    "unzipper": "^0.12.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/unzipper": "^0.10.10",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.3",
    "vite": "^7.3.6",
    "yaml": "^2.8.3"
  },
  "build": {
    "appId": "com.narra.app",
    "productName": "Narra",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "content/**/*",
      "!node_modules/@napi-rs/canvas*/**",
      "!node_modules/@napi-rs/canvas-*/**"
    ],
    "asar": true,
    "afterPack": "scripts/after-pack.cjs",
    "extraResources": [
      {
        "from": "content",
        "to": "content"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.book",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "minimumSystemVersion": "12.0"
    },
    "publish": {
      "provider": "generic",
      "url": "${env.NARRA_UPDATE_BASE_URL}",
      "channel": "latest"
    },
    "electronUpdaterCompatibility": ">=2.16",
    "artifactName": "${productName}-${version}-universal.${ext}"
  }
}
