# Narra gateway v2. Скопируй в .env только для локальной разработки.
# В Railway все значения задаются Variables; секреты не коммитятся.

PORT=8787
NODE_ENV=development

# Обязательные production secrets: независимые случайные строки >= 32 символов.
GATEWAY_TOKEN_SECRET=
ANALYTICS_HMAC_SECRET=
REGISTRATION_ACTIVATION_SECRET=
DATA_DIR=./.data
ANALYTICS_ENV=development

# Доставка в самостоятельный stats-narra (оба значения задаются вместе).
TRACTION_INGEST_URL=
TRACTION_INGEST_TOKEN=

# Командный LiteLLM / Giga-compatible OpenAI API.
# В production нужен HTTPS или Railway private networking/tunnel.
LLM_BASE_URL=http://localhost:4000
LLM_API_KEY=
LLM_MODEL=gigachat-3-ultra

# OpenRouter остаётся server-side: клиент не видит key/provider/model.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=Narra

# Маршрут по назначению. Допустимы только giga или openrouter.
LLM_ROUTE_DEFAULT=giga
LLM_ROUTE_CHARACTER_CHAT=giga
LLM_ROUTE_STRUCTURED_TASK=openrouter
LLM_ROUTE_SUMMARY=openrouter
LLM_ROUTE_SCENARIO=giga
LLM_ROUTE_MEMORY=giga
# Пустое значение = без cross-provider fallback.
LLM_FALLBACK_DEFAULT=

# SaluteSpeech: либо готовый Basic key, либо client id + secret.
SALUTESPEECH_AUTH_KEY=
SALUTESPEECH_CLIENT_ID=
SALUTESPEECH_CLIENT_SECRET=
SBER_SALUTE_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
SBER_SALUTE_SYNTH_URL=https://smartspeech.sber.ru/rest/v1/text:synthesize
SBER_SALUTE_RECOGNIZE_URL=https://smartspeech.sber.ru/rest/v1/speech:recognize

# Kandinsky image/video.
KANDINSKY_TOKEN=
VIDEO_BASE_URL=
# Временный video upstream Сони доступен только по HTTP. Включать строго
# осознанно и только до появления HTTPS: bearer token, изображения и аудио
# иначе идут по сети без шифрования.
ALLOW_INSECURE_VIDEO_HTTP=false
VIDEO_INSECURE_HTTP_HOSTS=87.242.117.37

# Проверка TLS включена по умолчанию. true допустим только для локальной диагностики.
ALLOW_INSECURE_TLS=false

# Browser dev preview; Electron main-process requests не требуют CORS wildcard.
CORS_ORIGINS=http://localhost:5173
REGISTRATION_LIMIT_PER_HOUR=10
API_LIMIT_PER_MINUTE=120
EVENT_LIMIT_PER_MINUTE=10
AI_LIMIT_PER_MINUTE=30
AI_LIMIT_PER_DAY=500
SPEECH_LIMIT_PER_MINUTE=60
SPEECH_LIMIT_PER_DAY=1000
IMAGE_LIMIT_PER_HOUR=30
IMAGE_LIMIT_PER_DAY=100
VIDEO_LIMIT_PER_HOUR=8
VIDEO_LIMIT_PER_DAY=20
KANDINSKY_QUEUE_LIMIT=6
VIDEO_QUEUE_LIMIT=4
LLM_CONCURRENCY=8
LLM_QUEUE_LIMIT=16
LLM_RESPONSE_MAX_MIB=8
SPEECH_CONCURRENCY=8
SPEECH_QUEUE_LIMIT=16
IMAGE_CONCURRENCY=4
IMAGE_QUEUE_LIMIT=12
IMPORT_LIMIT_PER_MINUTE=6
IMPORT_LIMIT_PER_DAY=20
IMPORT_LIMIT_MIB_PER_DAY=300
IMPORT_CONCURRENCY=2
IMPORT_QUEUE_LIMIT=2
