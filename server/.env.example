# ==== Ключи Сбера (заполни своими и переименуй в .env) ====
# GigaChat: вариант А — вставь готовый «Ключ авторизации» (длинная Base64-строка):
GIGACHAT_AUTH_KEY=
# GigaChat: вариант Б — вставь Client ID и Client Secret (проще найти в кабинете),
# сервер соберёт ключ сам. Заполни ЛИБО вариант А, ЛИБО вариант Б.
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=

# SaluteSpeech (озвучка). Если пусто — берётся ключ GigaChat (если у проекта есть
# доступ к SmartSpeech). Можно так же: либо готовый ключ, либо client id+secret.
SALUTESPEECH_AUTH_KEY=
SALUTESPEECH_CLIENT_ID=
SALUTESPEECH_CLIENT_SECRET=

# Kandinsky 6.0 (studio.kandinskylab.ai) — один Bearer-токен авторизации
KANDINSKY_TOKEN=

# ==== Модели GigaChat ====
# Модель живого чата с персонажами (качество характера).
GIGACHAT_CHAT_MODEL=GigaChat-3-Ultra
# Модель служебных задач (разметка глав, саммари, эмоции). Если появится доступ
# к более дешёвой модели (GigaChat-3-Pro/Lite/базовой) — поставь её сюда ради экономии.
GIGACHAT_TASK_MODEL=GigaChat-3-Ultra

# ==== Прочее ====
# Сертификаты Сбера — НУЦ Минцифры; для прототипа отключаем строгую проверку TLS
ALLOW_INSECURE_TLS=true
# Порт (Railway задаёт свой через PORT автоматически)
PORT=8787
# CORS: '*' для прототипа
CORS_ORIGIN=*
